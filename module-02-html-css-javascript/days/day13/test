/* Define custom properties in :root */
:root {
  --primary-color: #1B4D8E;
  --text-color: #FFFFFF;
  --spacing-btn: 12px 24px;
  --font-main: "Inter", system-ui, sans-serif;
}

/* Styled button using all four variables via var() */
.btn {
  background-color: var(--primary-color);
  color: var(--text-color);
  padding: var(--spacing-btn);
  font-family: var(--font-main);
  border: none;
  border-radius: 6px;
  cursor: pointer;
}


/* 1. Default content-box behavior */
.card-content-box {
  box-sizing: content-box;
  width: 300px;
  padding: 24px;
  border: 2px solid #333;
  /* 
    Rendered Width Calculation:
    300px (width) + 24px (left padding) + 24px (right padding) 
    + 2px (left border) + 2px (right border) 
    = 352px total rendered width
  */
}


.card-border-box {
  box-sizing: border-box;
  width: 300px;
  padding: 24px;
  border: 2px solid #333;
 
}


p { color: black; }           /* Element selector */
.note { color: blue; }         /* Class selector */
#lead { color: green; }        /* ID selector */



