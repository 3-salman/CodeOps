/* CSS Styling */
.flight-schedule {
  width: 100%;
  border-collapse: collapse;
  font-family: sans-serif;
}

/* Styled Header Row */
.flight-schedule th {
  background-color: #1B4D8E;
  color: #ffffff;
  text-align: left;
  padding: 12px 16px; /* Comfortable cell padding */
}

/* Comfortable Padding for Body Cells */
.flight-schedule td {
  padding: 12px 16px;
  border-bottom: 1px solid #e2e8f0;
}

/* Zebra Striping using :nth-child(even) */
.flight-schedule tbody tr:nth-child(even) {
  background-color: #f7fafc;
}